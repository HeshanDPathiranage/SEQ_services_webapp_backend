# Server Configuration
PORT=4000
NODE_ENV=production

# CORS Allowed Origins (Comma-separated production domains)
API_ORIGIN=https://seqservices.com.au,https://www.seqservices.com.au

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@seqservices.com.au
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=SEQ Services Quotations <contact@seqservices.com.au>
EMAIL_TO=admin@seqservices.com.au

# Google reCAPTCHA v2 Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
